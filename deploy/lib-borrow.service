[Unit]
Description=Faculty library borrowing system (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=libborrow
Group=libborrow
WorkingDirectory=@APP_DIR@/backend
EnvironmentFile=/etc/lib-borrow/lib-borrow.env
ExecStart=@APP_DIR@/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers @WORKERS@ \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3

# The site only needs to write under its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/lib-borrow

[Install]
WantedBy=multi-user.target
