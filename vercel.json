{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "backend/**",
      "excludeFiles": "{backend/.venv/**,backend/media/**,backend/staticfiles/**,backend/db.sqlite3,backend/**/__pycache__/**,backend/library/test_*.py,backend/library/tests.py}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|media/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/demo/reset", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/models/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
